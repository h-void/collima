{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "collima",
  "version": "0.1.0",
  "identifier": "io.github.hvoid.collima",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node ../scripts/build-web-if-needed.mjs",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "collima — 相机传感器与镜头光轴光学诊断工作台",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Camera sensor read-noise & lens optical tilt diagnostics workbench",
    "longDescription": "Local-first camera sensor read-noise calibration and lens optical focal-plane tilt diagnostics workbench powered by Rust and WebAssembly.",
    "licenseFile": "../LICENSE"
  }
}
